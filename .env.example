# Database
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require

# Neon Auth (managed Better Auth)
NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth

# Email
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=drop@abg.studio

# App
WEB_URL=http://localhost:5173
VITE_API_URL=https://abg-api.touch-apinankul.workers.dev/api

# PostHog (optional locally: analytics stays off without these)
# VITE_POSTHOG_KEY goes in packages/web/.env, because Vite reads that file.
# VITE_POSTHOG_KEY=phc_your_project_token
# POSTHOG_KEY=phc_your_project_token
# POSTHOG_HOST=https://eu.i.posthog.com

# Stripe (restricted key rk_test_… / rk_live_…). Do not commit real values.
# Local webhook secret comes from `stripe listen`.
STRIPE_SECRET_KEY=rk_test_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloudflare Worker local dev: copy DATABASE_URL (+ optional secrets) to packages/server/.dev.vars
